<mujoco model="two rooms and hallway">
  <include file="stretch.xml"/>

  <statistic center="3 0 1" extent="7" meansize="0.05"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="-120" elevation="-35"/>
  </visual>
  <asset>
    <material name="two_rooms_floor" rgba="0.35 0.35 0.35 1"/>
    <material name="two_rooms_wall" rgba="0.8 0.8 0.75 1"/>
  </asset>
  <default>
    <default class="two_rooms_wall">
      <geom type="box" material="two_rooms_wall" contype="1" conaffinity="1"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <light pos="6 0 4" dir="0 0 -1"/>
    <geom name="two_rooms_floor" type="plane" size="9 5 0.05" material="two_rooms_floor"/>

    <!-- Clear interiors: room 1 x=[-2,2], room 2 x=[4,8], y=[-2,2].
         Hallway x=[2,4], y=[-0.75,0.75]. Walls are 0.15 m thick,
         2.4 m tall; no ceiling, so the viewer can see into both rooms.
         Stretch's default pose at the origin is inside room 1. -->
    <geom name="room1_west" class="two_rooms_wall" pos="-2.075 0 1.2" size="0.075 2.15 1.2"/>
    <geom name="room1_north" class="two_rooms_wall" pos="0 2.075 1.2" size="2 0.075 1.2"/>
    <geom name="room1_south" class="two_rooms_wall" pos="0 -2.075 1.2" size="2 0.075 1.2"/>
    <geom name="room1_east_north" class="two_rooms_wall" pos="2.075 1.45 1.2" size="0.075 0.7 1.2"/>
    <geom name="room1_east_south" class="two_rooms_wall" pos="2.075 -1.45 1.2" size="0.075 0.7 1.2"/>

    <geom name="hallway_north" class="two_rooms_wall" pos="3 0.825 1.2" size="0.85 0.075 1.2"/>
    <geom name="hallway_south" class="two_rooms_wall" pos="3 -0.825 1.2" size="0.85 0.075 1.2"/>

    <geom name="room2_west_north" class="two_rooms_wall" pos="3.925 1.45 1.2" size="0.075 0.7 1.2"/>
    <geom name="room2_west_south" class="two_rooms_wall" pos="3.925 -1.45 1.2" size="0.075 0.7 1.2"/>
    <geom name="room2_north" class="two_rooms_wall" pos="6 2.075 1.2" size="2 0.075 1.2"/>
    <geom name="room2_south" class="two_rooms_wall" pos="6 -2.075 1.2" size="2 0.075 1.2"/>
    <geom name="room2_east" class="two_rooms_wall" pos="8.075 0 1.2" size="0.075 2.15 1.2"/>
  </worldbody>
</mujoco>
