<mujoco model="minimal stretch scene">
  <include file="stretch.xml"/>

  <statistic center="0 0 0.75" extent="2.5" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <asset>
    <material name="floor" rgba="0.35 0.35 0.35 1" reflectance="0.1"/>
    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.44 0.80 1.00"
      rgb2="1 1 1"
      width="512"
      height="3072"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="2.5 2.5 0.05" type="plane" material="floor"/>
  </worldbody>
</mujoco>
